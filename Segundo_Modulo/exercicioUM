import java.util.Scanner; // Added import statement

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("=======================================");
        System.out.println("  Seja Bem-Vindo(a) ao meu sistema Java!  ");
        System.out.println("=======================================");

        System.out.print("Digite o seu nome:  ");
        String nome = scanner.nextLine();

        System.out.print("Digite a sua idade:  ");
        int idade = scanner.nextInt();

        scanner.nextLine(); // Limpeza do buffer

        System.out.print("Digite a sua cidade:  ");
        String cidade = scanner.nextLine();

        System.out.println("\n--- Sada ---");
        System.out.println("Nome:  " + nome + ",  Idade:  " + idade + " anos,  Cidade:  " + cidade + ".");
        System.out.println("------------------------------");

        scanner.close();
    }
}
